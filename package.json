{
  "name": "egern-modules-optimized",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:combined": "node tools/build-combined-module.mjs",
    "build:netease": "node tools/build-netease.mjs",
    "benchmark:check": "node --expose-gc tools/benchmark.mjs",
    "check:combined": "node tools/build-combined-module.mjs --check",
    "import": "node tools/import-module.mjs",
    "integrity:update": "node tools/update-integrity.mjs",
    "integrity:check": "node tools/update-integrity.mjs --check",
    "migrate:surge": "node tools/migrate-surge-optimized.mjs",
    "migrate:netease": "node tools/migrate-netease.mjs",
    "sync": "node tools/sync-upstreams.mjs",
    "validate": "node tools/validate.mjs",
    "verify:raw": "node tools/verify-raw.mjs",
    "test": "npm run build:netease && node --test && npm run benchmark:check && npm run check:combined && npm run integrity:check && npm run validate"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "pako": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.46.2"
  }
}
